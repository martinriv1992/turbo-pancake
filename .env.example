# --- Product identity (rename the product without touching code) ---
NEXT_PUBLIC_APP_NAME="Universal Content Studio"
NEXT_PUBLIC_APP_TAGLINE="Create anything. Publish everywhere."

# --- Database ---
# Local: run `npm run db:local` then `npm run db:migrate`.
# Supabase: use the project's direct/pooler connection string (role must be able to SET ROLE authenticated).
DATABASE_URL="postgres://ucs_app:ucs_local_dev@127.0.0.1:5432/ucs"

# --- Sessions ---
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Auth: "local" (users in auth.users, bcrypt) or "supabase" (Supabase Auth; NOT yet tested against a live project) ---
AUTH_DRIVER="local"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Storage: "local" (filesystem) or "supabase" (Supabase Storage; NOT yet tested against a live project) ---
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
SUPABASE_STORAGE_BUCKET="ucs-assets"

# --- AI providers: keys are referenced by env var name from the AI Providers panel, never stored in the database ---
ANTHROPIC_API_KEY=""

# --- Worker: the job worker runs inside the Next.js server by default. Set to 0 and run `npm run worker` separately in production. ---
INLINE_WORKER="1"
